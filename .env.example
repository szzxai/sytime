PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# 高德 Web 服务 Key：仅服务器端使用，绝不可返回前端或提交到版本库
AMAP_SERVICE_KEY=
# 高德 Web 端 JS API Key：加载交互地图时会对浏览器可见；须用高德控制台域名白名单限制
AMAP_JS_KEY=
# 高德 JS API 安全密钥：仅按官方 JS API 安全配置使用；也请设置来源域名限制
AMAP_SECURITY_CODE=
# 允许添加店铺的最低登录角色：user/student/admin/super_admin/developer，默认 student
SHOP_CREATE_MIN_ROLE=student

# 首次初始化菜单：设置以下 Key 后运行 npm run menu:setup；后台加密保存，不随普通启动覆盖
GEMINI_API_KEY=
MENU_GEMINI_MODEL=gemini-flash-lite-latest
# 也可用 MENU_KEY_FILE 指定本地密钥文件；不要提交实际密钥
