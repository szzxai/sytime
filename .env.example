PORT=3000
# Production: set the exact HTTPS site origin and a random secret with at least 32 bytes.
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
AMAP_SERVICE_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
# Menu synchronization is managed exclusively by the server environment.
GEMINI_API_KEY=
MENU_PROVIDER=gemini
MENU_MODEL=gemini-flash-lite-latest
MENU_SYNC_ENABLED=true
MENU_SYNC_MODE=weekend
MENU_SYNC_TIME=08:00
# Compatible providers may use MENU_API_KEY and MENU_BASE_URL (HTTPS).
