PORT=3000
# Production: NODE_ENV=production (required for secure session cookies behind HTTP upstreams).
# Only actual socket peers / intermediate proxies, comma-separated IPs or CIDRs.
# Leave empty for direct connections. Never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXIES=
# Production: set the exact HTTPS site origin and a random secret with at least 32 bytes.
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
AMAP_SERVICE_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
# Menu synchronization is managed exclusively by the server environment.
GEMINI_API_KEY=
MENU_PROVIDER=gemini
MENU_MODEL=gemini-flash-lite-latest
MENU_SYNC_ENABLED=true
MENU_SYNC_MODE=weekend
MENU_SYNC_TIME=08:00
# Compatible providers may use MENU_API_KEY and MENU_BASE_URL (HTTPS).

# Club Union OIDC: register these exact URLs with the identity provider:
# Redirect URI: <APP_ORIGIN>/api/sso/callback
# Post logout redirect URI: <APP_ORIGIN>/login.html
OIDC_ISSUER=https://szzxclubunion.cn/o
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
